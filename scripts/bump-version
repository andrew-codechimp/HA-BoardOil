#!/usr/bin/env python3
"""Increment the revision (patch) version in manifest.json."""

import json
from pathlib import Path

MANIFEST_PATH = (
    Path(__file__).parent.parent / "custom_components" / "board_oil" / "manifest.json"
)


def bump_version() -> None:
    """Read manifest.json, increment patch version, and write it back."""
    # Read the manifest
    with MANIFEST_PATH.open(encoding="utf-8") as f:
        manifest = json.load(f)

    # Parse the current version
    current_version = manifest["version"]
    parts = current_version.split(".")

    if len(parts) != 3:  # noqa: PLR2004
        msg = f"Invalid version format: {current_version}. Expected major.minor.patch"
        raise ValueError(msg)

    major, minor, patch = parts
    patch = str(int(patch) + 1)

    # Create new version
    new_version = f"{major}.{minor}.{patch}"
    manifest["version"] = new_version

    # Write back to file with nice formatting
    with MANIFEST_PATH.open("w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")  # Add trailing newline

    print(f"Version bumped: {current_version} → {new_version}")  # noqa: T201


if __name__ == "__main__":
    bump_version()
